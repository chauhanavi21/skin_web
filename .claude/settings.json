{
  "permissions": {
    "allow": [
      "Bash(node *)", "Bash(npm install*)", "Bash(npm ci*)", "Bash(npm run *)", "Bash(npm start)", "Bash(npm test*)", "Bash(npx vite*)",
      "PowerShell(node *)", "PowerShell(npm install*)", "PowerShell(npm ci*)", "PowerShell(npm run *)", "PowerShell(npm start)", "PowerShell(npm test*)", "PowerShell(npx vite*)",

      "Bash(git init*)", "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git add*)",
      "Bash(git commit*)", "Bash(git branch*)", "Bash(git checkout*)", "Bash(git switch*)",
      "Bash(git pull*)", "Bash(git fetch*)", "Bash(git push*)", "Bash(git remote*)",
      "PowerShell(git init*)", "PowerShell(git status*)", "PowerShell(git diff*)", "PowerShell(git log*)", "PowerShell(git add*)",
      "PowerShell(git commit*)", "PowerShell(git branch*)", "PowerShell(git checkout*)", "PowerShell(git switch*)",
      "PowerShell(git pull*)", "PowerShell(git fetch*)", "PowerShell(git push*)", "PowerShell(git remote*)",
      "PowerShell(Remove-Item*)", "Bash(rm *)",

      "Edit", "Write"
    ],
    "deny": [
      "Bash(git push --force*)", "Bash(git push -f*)", "Bash(git reset --hard*)", "Bash(git clean*)", "Bash(rm -rf*)",
      "PowerShell(git push --force*)", "PowerShell(git push -f*)", "PowerShell(git reset --hard*)", "PowerShell(git clean*)",
      "PowerShell(Remove-Item -Recurse*)",
      "Read(./.env)", "Read(./.env.*)", "Read(**/data/jwt.secret)"
    ]
  }
}
